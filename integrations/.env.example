# ── clipcraft API ─────────────────────────────────────────────────────────
# Interpreter that has clipcraft's deps (whisper/torch/ffmpeg wiring) installed.
# "py -3" uses the Windows launcher; or give a full path to a venv python.exe.
CLIPCRAFT_PYTHON=py -3
# Optional shared secret. If set, n8n and the bot must send it as ?x-token=...
CLIPCRAFT_API_TOKEN=

# ── Discord bot ───────────────────────────────────────────────────────────
# Create an app + bot at https://discord.com/developers/applications
# Bot needs the "Send Messages" permission; no privileged intents required.
DISCORD_BOT_TOKEN=
# Right-click the target channel -> Copy Channel ID (enable Developer Mode).
DISCORD_CHANNEL_ID=
# Port the bot's HTTP server listens on (n8n calls this).
BOT_HTTP_PORT=8757
# Discord attachment cap for your server tier (25 = free tier). Clips larger
# than this are posted as a path + thumbnail instead of an inline video.
DISCORD_MAX_UPLOAD_MB=25
# Where the bot reaches the clipcraft API (same machine).
CLIPCRAFT_API=http://localhost:8756

# ── n8n (docker-compose) ──────────────────────────────────────────────────
N8N_PORT=5678
GENERIC_TIMEZONE=Asia/Jakarta
# n8n reaches the host-side clipcraft API + bot through host.docker.internal:
#   API  -> http://host.docker.internal:8756
#   bot  -> http://host.docker.internal:8757
